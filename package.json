{
  "name": "doubao-watermark-free-downloader",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "独立的豆包图片与视频无水印下载器，不依赖短剧工作台",
  "author": "Local Studio",
  "license": "UNLICENSED",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.local.doubao.downloader",
    "productName": "豆包无水印下载器",
    "electronVersion": "45.2.1",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.mjs",
      "preload-main.cjs",
      "preload-doubao.cjs",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "豆包无水印下载器-${version}-便携版.${ext}"
  }
}
